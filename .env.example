# ========================================================================
# Farm2Door — Environment Configuration
# ========================================================================

# Supabase Public Configuration (Client-side safe)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Privileged Configuration (Server-side only — DO NOT EXPOSE TO BROWSER)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Paystack Payment Gateway Configuration (Module 4)
PAYSTACK_PUBLIC_KEY=your-paystack-public-key
PAYSTACK_SECRET_KEY=your-paystack-secret-key

# JWT Authentication Secret (Module 1)
JWT_SECRET=super-secret-jwt-token-min-32-chars-long
